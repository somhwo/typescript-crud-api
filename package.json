{
  "name": "typescript-crud-api",
  "version": "2.0.0",
  "description": "A fully-typed TypeScript REST API using Express, Sequelize, MySQL and JWT authentication.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:dev": "nodemon --exec ts-node src/server.ts",
    "test": "ts-node tests/users.test.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "typescript",
    "express",
    "sequelize",
    "mysql",
    "jwt",
    "crud",
    "rest-api"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.20.0",
    "rootpath": "^0.1.2",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.17",
    "nodemo": "^1.0.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "directories": {
    "test": "tests"
  }
}
